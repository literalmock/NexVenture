PORT=5050
API_PREFIX=/api/v1
# Set this to the frontend origin you actually use, for example http://localhost:8082 in dev.
CLIENT_ORIGIN=http://localhost:8082
MONGODB_URI=mongodb://127.0.0.1:27017/nexventure
JWT_SECRET=replace-with-a-long-random-secret
# Must match frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
